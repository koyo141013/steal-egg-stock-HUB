-- FieldEggCarry 이벤트 감시 (줍기 감지용, 읽기 전용)
local function EnsureCarryListener()
    if getgenv().StealEggCarryHooked then return end
    if not Remotes or not Remotes.EggWorld or not Remotes.EggWorld.FieldEggCarry then return end
    getgenv().StealEggCarryHooked = true
    pcall(function()
        Remotes.EggWorld.FieldEggCarry.OnClientEvent:Connect(function(...)
            CarryState.at = os.clock()
            local args = {...}
            for _, a in ipairs(args) do
                if type(a) == "string" and #a == 32 and string.match(a, "^%x+$") then
                    CarryState.uid = a
                elseif type(a) == "table" and type(a.Uid) == "string" then
                    CarryState.uid = a.Uid
                end
            end
            CarryState.holding = true
            print("[StealEgg] FieldEggCarry 감지, uid=" .. tostring(CarryState.uid))
        end)
    end)
end

-- E 홀드 (실제 프롬프트 홀드 채우기용; VirtualInputManager 키 이벤트)
local function HoldE(seconds, hp0)
    seconds = seconds or 3
    local down, up
    local vim
    pcall(function() vim = game:GetService("VirtualInputManager") end)
    if vim then
        down = function()
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        end
        up = function()
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
    elseif typeof(keypress) == "function" and typeof(keyrelease) == "function" then
        down = function() keypress(0x45) end
        up = function() keyrelease(0x45) end
    else
        return false, T("키 입력 수단 없음", "No key input method")
    end
    local okDown = pcall(down)
    if not okDown then return false, T("키 입력 실패", "Key input failed") end
    -- v1.7 피격 중단: 시작 체력보다 많이 깎이면(몹/유저 공격) E를 놓고 즉시 귀환
    local fleeAt = (hp0 and (tonumber(Config.FleeHP) or 25) > 0) and (hp0 - (tonumber(Config.FleeHP) or 25)) or nil
    local t0 = os.clock()
    local hurt = false
    while os.clock() - t0 < seconds do
        if not getgenv().StealEggStock_Loaded then break end
        if fleeAt then
            local hpNow
            pcall(function()
                local ch = LocalPlayer.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if hum then hpNow = hum.Health end
            end)
            if hpNow and hpNow <= fleeAt then hurt = true break end
        end
        task.wait(0.25)
    end
    pcall(up)
    if hurt then
        return true, T("피격 감지 - 귀환!", "Hit detected - returning!")
    end
    return true, string.format(T("E 홀드 %.0f초", "E held %.0fs"), seconds)
end

local function FindCarryPrompt(pos)

-- 내 기지에 이 알이 들어왔는지 확인 (스틸 성공 판정)
    local best, bestD = nil, 15
    pcall(function()
        for _, d in ipairs(Workspace:GetChildren()) do
            if d.Name == "SmartPromptPart" and d:IsA("BasePart") then
                local dist = (d.Position - pos).Magnitude
                if dist < bestD then
                    local pr = d:FindFirstChild("CarryAreaEgg")
                    if pr and pr:IsA("ProximityPrompt") then
                        best, bestD = pr, dist
                    end
                end
            end
        end
    end)
    return best
end

local function FireCarryPrompt(prompt)
    if typeof(fireproximityprompt) ~= "function" then
        return false, T("E 자동발동 미지원 - 직접 E를 눌러줘", "Auto-E unsupported - press E manually")
    end
    local ok, err = pcall(function() fireproximityprompt(prompt) end)
    if ok then return true, T("E 자동발동 시도", "Auto-E fired") end
    return false, tostring(err):sub(1, 120)
end

-- 내 기지에 이 알이 들어왔는지 확인 (스틸 성공 판정)
local function CheckMineHas(uid)
    if not uid then return nil end
    local ok, live = pcall(function()
        return Remotes.EggWorld.AskLiveSnapshot:InvokeServer()
    end)
    if not ok or type(live) ~= "table" then return nil end
    for _, entry in ipairs(live) do
        if type(entry) == "table" and entry.OwnerUserId == LocalPlayer.UserId then
            if type(entry.Records) == "table" and entry.Records[uid] ~= nil then
                return true
            end
        end
    end
    return false
end

local function PickBestEgg()
    local best, bestRank = nil, -1
    for _, rec in ipairs(StockCache.Records or {}) do
        if rec.State == "Slot" or rec.State == "Dropped" then
            if PassFilter(rec) then
                local _, rank = GetRarityInfo(rec.AssetCategory)
                if rank > bestRank then best, bestRank = rec, rank end
            end
        end
    end
    if best and bestRank >= Config.MinRank then return best end
    return nil
end


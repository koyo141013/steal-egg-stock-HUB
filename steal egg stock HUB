function PassFilter(rec)
    local _, rank = GetRarityInfo(rec.AssetCategory)
    if rank < Config.MinRank then return false end
    local muts = GetMutations(rec)
    if Config.MutationOnly and #muts == 0 then return false end
    local q = string.lower(SearchBox.Text or "")
    if q ~= "" then
        local hay = string.lower(tostring(rec.AssetCategory) .. " " .. tostring(rec.AreaId) .. " " .. tostring(rec.NestId) .. " " .. tostring(rec.State))
        if not string.find(hay, q, 1, true) then return false end
    end
    return true
end

function RefreshList()
    for _, ch in ipairs(Scroll:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end
    local recs = StockCache.Records or {}
    local shown, total = 0, #recs
    -- 랭크 내림차순 정렬
    local sorted = {}
    for _, r in ipairs(recs) do table.insert(sorted, r) end
    table.sort(sorted, function(a, b)
        local _, ra = GetRarityInfo(a.AssetCategory)
        local _, rb = GetRarityInfo(b.AssetCategory)
        if ra ~= rb then return ra > rb end
        return tostring(a.AssetCategory) < tostring(b.AssetCategory)
    end)
    local hrp = GetHRP()
    for _, rec in ipairs(sorted) do
        if PassFilter(rec) then
            shown = shown + 1
            if shown > 120 then break end
            local rname, rank, dname = GetRarityInfo(rec.AssetCategory)
            local muts = GetMutations(rec)
            local distStr = "-"
            if hrp and typeof(rec.BottomCFrame) == "CFrame" then
                distStr = string.format("%dm", math.floor((hrp.Position - rec.BottomCFrame.Position).Magnitude / 3.28))
            end
            local row = Instance.new("Frame")

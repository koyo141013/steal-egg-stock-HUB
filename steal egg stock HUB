local function GetRarityInfo(category)
    local entry = AssetDir[category]
    if entry and entry.Rarity then
        return entry.Rarity._id or entry.Rarity.DisplayName or "?", tonumber(entry.Rarity.Rank) or 0, entry.Rarity.DisplayName or tostring(entry.Rarity._id)
    end
    return "?", 0, "?"
end

local function GetMutations(rec)
    if type(rec.Mutations) == "table" then
        local t = {}
        for _, m in pairs(rec.Mutations) do table.insert(t, tostring(m)) end
        if rec.BaseMutation and #t == 0 then table.insert(t, tostring(rec.BaseMutation)) end
        return t
    end
    if rec.BaseMutation then return { tostring(rec.BaseMutation) } end
    return {}
end

local function FetchStock()
    if not Remotes or not Remotes.EggWorld or not Remotes.EggWorld.AskFieldEggSnapshot then
        return nil, T("Remotes.EggWorld.AskFieldEggSnapshot 없음", "Missing Remotes.EggWorld.AskFieldEggSnapshot")
    end
    local ok, res = pcall(function()
        return Remotes.EggWorld.AskFieldEggSnapshot:InvokeServer()
    end)
    if not ok then return nil, T("Invoke 실패: ", "Invoke failed: ") .. tostring(res):sub(1, 200) end
    if type(res) ~= "table" then return nil, T("응답 타입 이상: ", "Bad response type: ") .. type(res) end
    return res, nil
end

local function TryCarry(uid)
    if not Remotes or not Remotes.EggWorld or not Remotes.EggWorld.AskFieldEggCarry then
        return false, "AskFieldEggCarry 리모트 없음"
    end
    local rf = Remotes.EggWorld.AskFieldEggCarry
    local attempts = {
        { args = { uid }, desc = "uid" },
        { args = { { Uid = uid } }, desc = "{Uid}" },
        { args = { { uid = uid } }, desc = "{uid}" },
    }
    local lastErr = ""
    for _, a in ipairs(attempts) do
        local ok, res = pcall(function()
            return rf:InvokeServer(table.unpack(a.args))
        end)
        if ok then
            return true, "시도(" .. a.desc .. ") 성공: " .. tostring(res):sub(1, 200)
        else
            lastErr = tostring(res):sub(1, 200)
        end
    end
    return false, T("전부 실패: ", "All attempts failed: ") .. lastErr
end

local function TryHatch(uid)
    if not Remotes or not Remotes.EggWorld or not Remotes.EggWorld.AskHatch then
        return false, "AskHatch 리모트 없음"
    end
    local ok, res = pcall(function()
        return Remotes.EggWorld.AskHatch:InvokeServer(uid)
    end)
    if ok then return true, tostring(res):sub(1, 200) end
    return false, tostring(res):sub(1, 200)
end


    local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(0, 6) cc.Parent = b
    local state = initial
    local function refresh()
        if cb == nil then b.Text = text; b.BackgroundColor3 = Color3.fromRGB(70, 130, 255); return end
        b.Text = text .. ":" .. (state and "ON" or "OFF")
        b.BackgroundColor3 = state and Color3.fromRGB(30, 140, 70) or Color3.fromRGB(140, 35, 35)
    end
    refresh()
    if cb then
        b.MouseButton1Click:Connect(function() state = not state refresh() cb(state) end)
    end
    return b, function() return state end, function(v) state = v refresh() end
end


function ClearESP()
    for _, o in ipairs(ESPAdorns) do pcall(function() o:Destroy() end) end
    table.clear(ESPAdorns)
end

local function FindWorkspaceModelByUid(uid)
    local m = Workspace:FindFirstChild(uid, true)
    if m and m:IsA("Model") then return m end
    -- Uid가 이름인 모델 탐색 (얕게)
    for _, ch in ipairs(Workspace:GetChildren()) do
        if ch.Name == uid then return ch end
    end
    return nil
end

local function UpdateESP(records)
    if not Config.ESP then return end
    ClearESP()
    for _, rec in ipairs(records) do
        local cf = rec.BottomCFrame
        if typeof(cf) == "CFrame" then
            local adorn = Instance.new("SphereHandleAdornment")
            adorn.Radius = 2
            adorn.Transparency = 0.35
            local _, rank = GetRarityInfo(rec.AssetCategory)
            if rank >= 8 then adorn.Color3 = Color3.fromRGB(255, 50, 50)
            elseif rank >= 6 then adorn.Color3 = Color3.fromRGB(255, 150, 30)
            elseif rank >= 4 then adorn.Color3 = Color3.fromRGB(180, 80, 255)
            else adorn.Color3 = Color3.fromRGB(80, 180, 255) end
            adorn.Adornee = Workspace.Terrain
            adorn.CFrame = cf + Vector3.new(0, 2, 0)
            adorn.AlwaysOnTop = true
            adorn.ZIndex = 5
            adorn.Parent = CoreGui
            table.insert(ESPAdorns, adorn)
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 220, 0, 40)
            bb.StudsOffset = Vector3.new(0, 5, 0)
            bb.AlwaysOnTop = true
            bb.Adornee = Workspace.Terrain
            bb.ExtentsOffsetWorldSpace = cf.Position
            -- Adornee 대신 직접 위치 쓰기 위해 Part 이용
            bb.Parent = CoreGui
            table.insert(ESPAdorns, bb)
            local tl = Instance.new("TextLabel")
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            tl.BackgroundTransparency = 0.4
            tl.TextColor3 = Color3.fromRGB(255, 255, 255)
            tl.Font = Enum.Font.GothamBold tl.TextSize = 12
            local rname, rrank = GetRarityInfo(rec.AssetCategory)
            tl.Text = string.format("%s [%s R%d]\n%s", tostring(rec.AssetCategory), tostring(rname), rrank, tostring(rec.AreaId))
            tl.Parent = bb
            -- Billboard 위치 고정용: 매 프레임 갱신은 아래 RenderStepped에서 처리하지 않고 1회성으로 둠 (Terrain adornee 한계)
            -- 대신 10초 뒤 자동 제거 (리프레시 때 재생성)
            task.delay(10, function() pcall(function() bb:Destroy() adorn:Destroy() end) end)
        end
    end
end

function PassFilter(rec)
    local _, rank = GetRarityInfo(rec.AssetCategory)
    if rank < Config.MinRank then return false end
    local muts = GetMutations(rec)
    if Config.MutationOnly and #muts == 0 then return false end
    local q = string.lower(SearchBox.Text or "")
    if q ~= "" then
        local hay = string.lower(tostring(rec.AssetCategory) .. " " .. tostring(rec.AreaId) .. " " .. tostring(rec.NestId) .. " " .. tostring(rec.State))
        if not string.find(hay, q, 1, true) then return false end
    end
    return true
end

function RefreshList()
    for _, ch in ipairs(Scroll:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end
    local recs = StockCache.Records or {}
    local shown, total = 0, #recs
    -- 랭크 내림차순 정렬

-- Homestead 슬롯에서 내 Plot을 찾아 스폰 지점 CFrame 반환
local function ResolveHomeCF()
    local cf
    pcall(function()
        if not Remotes or not Remotes.Homestead or not Remotes.Homestead.AskState then return end
        local st = Remotes.Homestead.AskState:InvokeServer()
        if type(st) == "table" and type(st.OwnersBySlot) == "table" then
            for slot, uid in pairs(st.OwnersBySlot) do
                if uid == LocalPlayer.UserId then
                    local plots = Workspace:FindFirstChild("Plots")
                    local plot = plots and plots:FindFirstChild(tostring(slot))
                    if plot then
                        local sp = plot:FindFirstChild("SpawnPoint")
                        if sp and sp:IsA("BasePart") then cf = sp.CFrame return end
                        local cp = plot:FindFirstChild("CenterPoint")
                        if cp and cp:IsA("BasePart") then cf = cp.CFrame return end
                        cf = plot:GetPivot()
                        return
                    end
                end
            end
        end
    end)
    return cf
end

local function GoHomeNow(reason)
    task.spawn(function()
        local cf = ResolveHomeCF()
        if not cf then
            Notify(T("귀환 실패", "Return failed"), T("내 기지를 못 찾았어 (Homestead 확인 실패)", "Home base not found (Homestead check failed)"))

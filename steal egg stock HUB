-- 핵심 시퀀스: 알 TP(낮게) → E발동 시도 → E 3초 홀드 → 기지 귀환 → 확인
-- 수동 스틸 버튼 + 자동스틸 공용. 전역이라 GUI 버튼에서도 호출 가능.
function StealEggDoSteal(rec, isAuto)
    if Config.SafeMode then
        Notify(T("세이프 모드", "Safe mode"), T("차단됨: 업데이트 탭에서 해제해야 스틸 가능 (킥/BAC 위험)", "Blocked: disable safe mode in Updates tab to steal (kick/BAC risk)"))
        return
    end
    if SE.busy then
        Notify(T("작업 중", "Busy"), T("이전 작업 끝날 때까지 대기해줘", "Wait for the previous job to finish"))
        return
    end
    if not rec or typeof(rec.BottomCFrame) ~= "CFrame" then
        Notify(T("스틸 실패", "Steal failed"), T("좌표 없음", "No coordinates"))
        return
    end
    SE.busy = true
    SE.phase = "run"
    UpdatePhaseLabel()
    local tag = tostring(rec.AssetCategory)
    task.spawn(function()
        local function done(msg, ok)
            Status.Text = msg
            Notify(ok and T("스틸", "Steal") or T("스틸 실패", "Steal failed"), tostring(msg):sub(1, 120), 4)
            SE.busy = false
            SE.phase = "idle"
            UpdatePhaseLabel()
            DoFetch(false)
        end
        -- 1) 알로 이동 (프롬프트 범위 8 안에 들도록 낮게)
        Status.Text = (isAuto and T("자동스틸: ", "Auto-steal: ") or "") .. tag .. T("로 이동중", " moving")
        local okTP, _, msgTP = TeleportTo(rec.BottomCFrame, { alt = 5 })
        if not okTP then
            done(T("알 TP 실패: ", "Egg TP failed: ") .. tostring(msgTP):sub(1, 80), false)
            return
        end
        task.wait(0.4)
        -- 시작 체력 기록 (v1.7 피격 중단용)
        local hp0
        pcall(function()
            local ch = LocalPlayer.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum then hp0 = hum.Health end
        end)
        -- 2) 즉시 발동 시도
        if Config.AutoFireE ~= false then
            local pr = FindCarryPrompt(rec.BottomCFrame.Position)
            if pr then pcall(function() FireCarryPrompt(pr) end) end
        end
        -- 3) E 홀드 (프롬프트 1.2초 + 여유)
        local holdSec = tonumber(Config.EHoldSec) or 3
        Status.Text = tag .. T(" 앞에서 E 홀드 중... (", " holding E... (") .. tostring(holdSec) .. T("초)", "s)")
        local _, msgH = HoldE(holdSec, hp0)
        Status.Text = tag .. " " .. tostring(msgH) .. T(" → 기지로 복귀", " → returning home")
        task.wait(0.3)
        -- 4) 기지로 귀환
        local cf = ResolveHomeCF()
        if not cf then
            done(T("귀환 실패: 내 기지를 못 찾았어", "Return failed: home base not found"), false)
            return
        end
        local okH2, _, msgH2 = TeleportTo(cf)
        if not okH2 then
            done(T("귀환 실패: ", "Return failed: ") .. tostring(msgH2):sub(1, 80), false)
            return
        end
        task.wait(1.0)
        -- 5) 내 기지에 들어왔는지 확인
        local has = CheckMineHas(rec.Uid)
        if has == true then
            done(T("스틸 성공! ", "Steal success! ") .. tag .. T(" 내 기지 확인됨", " confirmed at home"), true)
        elseif has == false then
            done(T("귀환 완료. ", "Returned. ") .. tag .. T(" 배치 미확인 - 직접 확인해줘", " placement unconfirmed - check manually"), true)
        else
            done(T("귀환 완료. ", "Returned. ") .. tag .. T(" (확인 불가)", " (unverifiable)"), true)
        end
    end)
end


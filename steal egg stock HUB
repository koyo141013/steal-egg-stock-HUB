        end
        Notify(T("귀환 중", "Returning"), reason or T("내 기지로 이동", "Moving to home base"))
        local ok, _, msg = TeleportTo(cf)
        Notify(ok and T("귀환 완료", "Returned") or T("귀환 실패", "Return failed"), tostring(msg), 4)
    end)
end


local function DoFetch(manual)
    Status.Text = "불러오는 중..."
    local res, err = FetchStock()
    if not res then
        Status.Text = "실패: " .. tostring(err)
        if manual then Notify("스톡 실패", tostring(err), 4) end
        return
    end
    local list = res.Records or res.records or {}
    -- Records가 dict 형태면 array로 변환
    local arr = {}
    if #list > 0 then arr = list
    else for _, v in pairs(list) do table.insert(arr, v) end end
    StockCache.Records = arr
    StockCache.ServerTime = res.ServerTime or 0
    StockCache.FetchedAt = os.clock()
    -- 희귀 알림
    if Config.NotifyRare then
        for _, rec in ipairs(arr) do
            local _, rank = GetRarityInfo(rec.AssetCategory)
            if rank >= Config.NotifyRank and not NotifiedUids[rec.Uid] then
                NotifiedUids[rec.Uid] = true
                Notify("희귀 알!", string.format("%s [%s R%d] @%s", tostring(rec.AssetCategory), tostring((GetRarityInfo(rec.AssetCategory))), rank, tostring(rec.AreaId)), 5)
            end
        end
    end
    RefreshList()
    UpdateESP(arr)
end

RefreshBtn.MouseButton1Click:Connect(function() DoFetch(true) end)

-- 자동 스틸 루프: 최고 랭크 1개 시도
local function AutoStealTick()
    if not Config.AutoSteal then return end
    local best, bestRank = nil, -1
    for _, rec in ipairs(StockCache.Records or {}) do
        if rec.State == "Slot" or rec.State == "Dropped" then
            if PassFilter(rec) then
                local _, rank = GetRarityInfo(rec.AssetCategory)
                if rank > bestRank then best, bestRank = rec, rank end
            end
        end
    end
    if best and bestRank >= Config.MinRank then
        if typeof(best.BottomCFrame) == "CFrame" then TeleportTo(best.BottomCFrame) end
        task.wait(0.4)
        local ok, msg = TryCarry(best.Uid)
        Status.Text = (ok and "자동스틸 성공: " or "자동스틸 실패: ") .. tostring(best.AssetCategory) .. " " .. tostring(msg):sub(1, 80)
        task.wait(1.5)
        DoFetch(false)
    end
end


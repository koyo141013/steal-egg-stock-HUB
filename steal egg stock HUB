local function ZeroMotion(hrp)
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
    pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
    -- 구버전 호환
    pcall(function() hrp.Velocity = Vector3.zero end)
    pcall(function() hrp.RotVelocity = Vector3.zero end)
end

local function HardSet(hrp, cframe)
    pcall(function() hrp.CFrame = cframe end)
    pcall(function()
        local char = LocalPlayer.Character
        if char then char:PivotTo(cframe) end
    end)
    ZeroMotion(hrp)
end

-- v1.3 장거리 TP + 서버 되돌림(RigSync Correction) + 사망 방지:
-- 전구간 앵커(추락사 차단) + 바닥확인 + 실패시 출발지 복귀 + 재시도
-- 반환: success(bool), dist(number), msg(string)
local function SetCharCollide(char, collide)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            pcall(function()
                if collide then
                    p.CanCollide = (p.Name ~= "Head")
                else
                    p.CanCollide = false
                end
            end)
        end
    end
end

local function HasGroundBelow(pos, char)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
    params.IgnoreWater = false
    local ok, hit = pcall(function()
        return Workspace:Raycast(pos, Vector3.new(0, -60, 0), params)
    end)
    return ok and hit ~= nil
end

-- v1.6 겹침 없는 착지점: 바닥 위 + 캐릭터 크기만큼 빈 공간 확인
local function FindSafeSpot(pos, char)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char }
    params.IgnoreWater = true
    local hit
    pcall(function()
        hit = Workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -80, 0), params)
    end)
    local baseY = hit and (hit.Position.Y + 4.5) or pos.Y
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = { char }
    op.MaxParts = 20
    -- 바닥부터 위로 30까지 첫 빈 자리 탐색
    for lift = 0, 30, 3 do
        local cand = Vector3.new(pos.X, baseY + lift, pos.Z)
        local blocked = false
        pcall(function()
            local parts = Workspace:GetPartBoundsInBox(CFrame.new(cand), Vector3.new(4, 6, 3), op)
            for _, p in ipairs(parts) do
                if p.CanCollide then blocked = true break end
            end
        end)
        if not blocked then
            return CFrame.new(cand), cand
        end
    end
    return CFrame.new(pos.X, baseY + 30, pos.Z), Vector3.new(pos.X, baseY + 30, pos.Z)
end

local function RestoreChar(char, hrp, hum)
    pcall(function() hrp.Anchored = false end)
    SetCharCollide(char, true)
    pcall(function()
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)
end

local TPBusy = false
local function TeleportToInner(cf, opts)
    opts = opts or {}
    local hrp = GetHRP()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid") or nil
    if not hrp or not cf or typeof(cf) ~= "CFrame" then return false, math.huge, T("좌표/HRP 없음", "No coordinates/HRP") end
    if not hum or hum.Health <= 0 then return false, math.huge, T("캐릭터 사망 상태", "Character is dead") end

    local step = tonumber(opts.step or Config.TPStep) or 450
    if step < 100 then step = 100 end
    if step > 2000 then step = 2000 end
    local timeout = tonumber(opts.timeout or Config.TPTimeout) or 15
    local tolerance = tonumber(opts.tolerance or Config.TPTolerance) or 15
    local holdTime = tonumber(opts.hold or Config.TPHold) or 1.5
    local maxRetry = tonumber(opts.retry or Config.TPRetry) or 3
    local alt = tonumber(opts.alt or Config.TPAlt) or 10
    local groundWait = tonumber(opts.groundWait or Config.TPGroundWait) or 3
    local safeReturn = (opts.safeReturn == nil) and (Config.TPSafeReturn ~= false) or opts.safeReturn

    local startCF = hrp.CFrame
    local targetPos = cf.Position + Vector3.new(0, alt, 0)
    local targetCF = CFrame.new(targetPos)

    -- 사망 감지 + v1.6 사망 원인 기록 (앵커 상태면 서버킬 의심)
    local stage = "준비"
    local died = false
    local diedConn
    pcall(function()
        diedConn = hum.Died:Connect(function()
            died = true
            pcall(function()
                local st = getgenv().StealEgg
                if st then
                    st.lastDeath = {
                        time = os.date("%H:%M:%S"),
                        stage = stage,
                        anchored = tostring(hrp and hrp.Parent and hrp.Anchored),
                        pos = hrp and hrp.Parent and string.format("%.0f,%.0f,%.0f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z) or "?",
                    }
                end
            end)
        end)
    end)

    local function cleanupConn()
        pcall(function() if diedConn then diedConn:Disconnect() end end)
    end

    for attempt = 1, math.max(1, maxRetry) do
        if not getgenv().StealEggStock_Loaded then cleanupConn() return false, math.huge, T("언로드됨", "Unloaded") end
        hrp = GetHRP()
        char = LocalPlayer.Character
        hum = char and char:FindFirstChildOfClass("Humanoid") or nil
        if died or not hrp or not hum or hum.Health <= 0 then
            cleanupConn()
            return false, math.huge, T("이동 중 사망/리스폰됨", "Died/respawned while moving")
        end

        -- 1) 충돌 OFF + 즉시 앵커 (이 시점부터 추락 불가)
        stage = "이동준비"
        pcall(function()
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
        SetCharCollide(char, false)
        pcall(function() hum.PlatformStand = true end)
        pcall(function() hrp.Anchored = true end)
        HardSet(hrp, hrp.CFrame)
        -- 2) 목표 지점 스트리밍 요청 (앵커 상태라 떨어지지 않음)
        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(targetPos, 3)
        end)
        task.wait(0.2)

        local t0 = os.clock()
        -- 3) 앵커 상태로 단계별 이동 (빈 청크 통과해도 추락사 없음)
        stage = "이동중"
        local aborted = false
        while getgenv().StealEggStock_Loaded and not died do
            if not hrp.Parent then aborted = true break end
            if os.clock() - t0 > timeout then break end
            local dist = (hrp.Position - targetPos).Magnitude
            if dist <= math.max(step, tolerance) then break end
            local dir = (targetPos - hrp.Position).Unit
            HardSet(hrp, CFrame.new(hrp.Position + dir * step))
            RunService.Heartbeat:Wait()
            RunService.Heartbeat:Wait()
        end
        if died or aborted or not hrp.Parent then
            RestoreChar(char, hrp, hum)
            cleanupConn()
            return false, math.huge, T("이동 중 사망/리스폰됨", "Died/respawned while moving")
        end
        HardSet(hrp, targetCF)

        -- 4) 앵커 홀드: 서버 Correction이 와도 안 끌려감
        stage = "고정홀드"
        local holdUntil = os.clock() + holdTime
        while os.clock() < holdUntil and not died do
            if not hrp.Parent then break end
            HardSet(hrp, targetCF)
            RunService.Heartbeat:Wait()
        end
        if died then
            RestoreChar(char, hrp, hum)
            cleanupConn()
            return false, math.huge, T("도착 직후 사망함", "Died right after arrival")
        end

        -- 5) 바닥 확인: 로딩 안 된 허공이면 해제하지 말고 대기/복귀 (추락사 방지)
        stage = "바닥확인"
        local waited = 0
        while waited < groundWait and not HasGroundBelow(targetPos, char) do
            pcall(function() LocalPlayer:RequestStreamAroundAsync(targetPos, 2) end)
            task.wait(0.5)
            waited = waited + 0.5
            HardSet(hrp, targetCF)
        end
        if not HasGroundBelow(targetPos, char) then
            if safeReturn then
                HardSet(hrp, startCF)
                task.wait(0.2)
                RestoreChar(char, hrp, hum)
                cleanupConn()
                return false, math.huge, T("목적지 바닥 없음 - 출발지로 복귀함", "No ground at destination - returned to start")
            end
            -- 복귀 OFF면 그래도 해제 (사용자 선택)
        end

        -- 6) v1.6 겹침 없는 착지점 계산 후 앵커 상태로 미리 안착
        stage = "착지점계산"
        local safeCF, safePos = FindSafeSpot(targetPos, char)
        HardSet(hrp, safeCF)
        task.wait(0.2)

        -- 7) 고정 해제 + 복구 + 최종 스냅
        stage = "해제"
        RestoreChar(char, hrp, hum)
        for i = 1, 4 do
            if not hrp.Parent or died then break end
            HardSet(hrp, safeCF)
            task.wait(0.08)
        end
        task.wait(0.3)
        if died or not hrp.Parent then
            cleanupConn()
            return false, math.huge, T("착지 중 사망/리스폰됨", "Died/respawned while landing")
        end

        -- 8) v1.6 착지 감시 1.5초: 허공 추락/튕김 캐치 → 안전지점으로 구조
        stage = "착지감시"
        local watchUntil = os.clock() + 1.5
        local unstable = nil
        while os.clock() < watchUntil and not died do
            if not hrp.Parent then break end
            local spd = 0
            pcall(function() spd = hrp.AssemblyLinearVelocity.Magnitude end)
            if hrp.Position.Y < safePos.Y - 30 then
                unstable = "허공 추락 감지"
                break
            end
            if spd > 250 then
                unstable = "튕김 감지"
                break
            end
            RunService.Heartbeat:Wait()
        end
        if unstable and not died and hrp.Parent then
            -- Status는 GUI 영역 local이라 여기서 직접 못 씀. pcall로 안전하게만 시도.
            pcall(function() Status.Text = unstable .. " → 안전지점으로 구조 중..." end)
            pcall(function() hrp.Anchored = true end)
            HardSet(hrp, safeCF)
            task.wait(0.3)
            RestoreChar(char, hrp, hum)
            task.wait(0.4)
        end
        if died or not hrp.Parent then
            cleanupConn()
            return false, math.huge, T("착지 중 사망/리스폰됨", "Died/respawned while landing")
        end
        local finalDist = (hrp.Position - safePos).Magnitude
        if finalDist <= tolerance then
            cleanupConn()
            return true, finalDist, string.format(T("도착 (%.1f stud, %d회차)", "Arrived (%.1f stud, try %d)"), finalDist, attempt)
        end
        -- 되돌려졌으면 다음 회차에서 재시도
        if attempt < maxRetry then task.wait(0.4) end
    end
    cleanupConn()
    local d = GetHRP() and (GetHRP().Position - targetPos).Magnitude or math.huge
    return false, d, string.format(T("미도착 (남은 %.0f stud) - 서버가 되돌림. TPStep을 250으로 낮춰봐", "Not arrived (%.0f stud left) - server pulls back. Lower TPStep to 250"), d)
end

-- v1.5 TP 뮤텍스: 동시 이동 요청이 서로 잡아당기는 것 방지
local function TeleportTo(cf, opts)
    if TPBusy then return false, math.huge, T("다른 이동 진행 중", "Another move in progress") end
    if Config.SafeMode then return false, math.huge, T("세이프 모드 ON - 업데이트 탭에서 해제", "Safe mode ON - disable it in Updates tab") end
    TPBusy = true
    local ok, a, b, c = pcall(TeleportToInner, cf, opts)
    TPBusy = false
    if not ok then return false, math.huge, T("이동 중 오류: ", "Move error: ") .. tostring(a):sub(1, 100) end
    return a, b, c
end


-- v1.6 사망 로거: 언제/어디서/무슨 단계에서 죽었는지 기록 (원인 판별용)
-- 앵커 상태에서 죽으면 = 서버킬 의심 / 추락이면 = 물리 문제
local function HookDeathLog(ch)
    task.spawn(function()
        local hum
        pcall(function() hum = ch:WaitForChild("Humanoid", 10) end)
        if not hum then return end
        hum.Died:Connect(function()
            local info = ""
            pcall(function()
                local hrp2 = ch:FindFirstChild("HumanoidRootPart")
                local st = getgenv().StealEgg
                local last = st and st.lastDeath
                info = string.format("위치 %s | 단계 %s | 앵커 %s",
                    hrp2 and string.format("%.0f,%.0f,%.0f", hrp2.Position.X, hrp2.Position.Y, hrp2.Position.Z) or "?",
                    (last and (last.stage .. "/" .. last.time)) or ((st and st.phase) or "?"),
                    hrp2 and tostring(hrp2.Anchored) or "?")
            end)
            Notify("사망 감지", info, 5)
            print("[StealEgg] 사망 " .. info)
        end)
    end)
end
table.insert(Connections, LocalPlayer.CharacterAdded:Connect(HookDeathLog))
if LocalPlayer.Character then HookDeathLog(LocalPlayer.Character) end


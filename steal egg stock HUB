end

-- 핵심 시퀀스: 알 TP(낮게) → E발동 시도 → E 3초 홀드 → 기지 귀환 → 확인
-- 수동 스틸 버튼 + 자동스틸 공용. 전역이라 GUI 버튼에서도 호출 가능.
function StealEggDoSteal(rec, isAuto)
    if SE.busy then
        Notify("작업 중", "이전 작업 끝날 때까지 대기해줘")
        return
    end
    if not rec or typeof(rec.BottomCFrame) ~= "CFrame" then
        Notify("스틸 실패", "좌표 없음")
        return
    end
    SE.busy = true
    SE.phase = "run"
    UpdatePhaseLabel()
    local tag = tostring(rec.AssetCategory)
    task.spawn(function()
        local function done(msg, ok)
            Status.Text = msg
            Notify(ok and "스틸" or "스틸 실패", tostring(msg):sub(1, 120), 4)
            SE.busy = false
            SE.phase = "idle"
            UpdatePhaseLabel()
            DoFetch(false)
        end
        -- 1) 알로 이동 (프롬프트 범위 8 안에 들도록 낮게)
        Status.Text = (isAuto and "자동스틸: " or "") .. tag .. "로 이동중"
        local okTP, _, msgTP = TeleportTo(rec.BottomCFrame, { alt = 5 })
        if not okTP then
            done("알 TP 실패: " .. tostring(msgTP):sub(1, 80), false)
            return
        end
        task.wait(0.4)
        -- 2) 즉시 발동 시도
        if Config.AutoFireE ~= false then
            local pr = FindCarryPrompt(rec.BottomCFrame.Position)
            if pr then pcall(function() FireCarryPrompt(pr) end) end
        end
        -- 3) E 홀드 (프롬프트 1.2초 + 여유)
        local holdSec = tonumber(Config.EHoldSec) or 3
        Status.Text = tag .. " 앞에서 E 홀드 중... (" .. tostring(holdSec) .. "초)"
        local _, msgH = HoldE(holdSec)
        Status.Text = tag .. " " .. tostring(msgH) .. " → 기지로 복귀"
        task.wait(0.3)
        -- 4) 기지로 귀환
        local cf = ResolveHomeCF()
        if not cf then
            done("귀환 실패: 내 기지를 못 찾았어", false)
            return
        end
        local okH2, _, msgH2 = TeleportTo(cf)
        if not okH2 then
            done("귀환 실패: " .. tostring(msgH2):sub(1, 80), false)
            return
        end
        task.wait(1.0)
        -- 5) 내 기지에 들어왔는지 확인
        local has = CheckMineHas(rec.Uid)
        if has == true then
            done("스틸 성공! " .. tag .. " 내 기지 확인됨", true)
        elseif has == false then
            done("귀환 완료. " .. tag .. " 배치 미확인 - 직접 확인해줘", true)
        else
            done("귀환 완료. " .. tag .. " (확인 불가)", true)
        end
    end)
end

-- 0.5초마다 도는 상태머신 (긴 작업은 StealEggDoSteal 안 spawn으로)
local function StealFastTick()
    EnsureCarryListener()
    if SE.phase == "idle" and Config.AutoSteal and not SE.busy then
        local best = PickBestEgg()
        if best then StealEggDoSteal(best, true) end
    end
    UpdatePhaseLabel()
end


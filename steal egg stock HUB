task.spawn(function()
    DoFetch(false)
    local lastSlow = os.clock()
    while getgenv().StealEggStock_Loaded do
        task.wait(0.5)
        if not getgenv().StealEggStock_Loaded then break end
        pcall(StealFastTick)
        local slowSec = math.max(3, tonumber(Config.RefreshSec) or 5)
        if Config.AutoRefresh and os.clock() - lastSlow >= slowSec then
            lastSlow = os.clock()
            -- TP/귀환 작업 중에는 스톡 갱신으로 상태창 덮지 않기
            if SE.phase == "idle" then
                DoFetch(false)
            end
        end
    end
end)

